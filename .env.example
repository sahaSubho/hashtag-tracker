# Copy to .env and fill in real values. .env is git-ignored — never commit real secrets.

NODE_ENV=development
APP_ROLES=api,sync-worker,download-worker,relay,scheduler
PORT=3000
METRICS_PORT=9100

DATABASE_URL=postgres://tracker_app:app_password@localhost:5432/hashtag_tracker
DATABASE_URL_READONLY=postgres://tracker_graphql:graphql_password@localhost:5432/hashtag_tracker
DATABASE_URL_MIGRATOR=postgres://tracker_migrator:migrator_password@localhost:5432/hashtag_tracker

SECRETS_SOURCE=env

# Meta / Instagram Graph API — never commit real values here.
META_ACCESS_TOKEN=replace-with-real-token-in-local-.env-only
META_APP_SECRET=
META_IG_USER_ID=replace-with-real-ig-business-id
META_API_VERSION=v24.0

HASHTAG=matcha

SYNC_INTERVAL_CRON=0 */3 * * *
SYNC_MAX_ITEMS=500
SYNC_SKEW_MINUTES=10

DOWNLOAD_CONCURRENCY=5
DOWNLOAD_MAX_ATTEMPTS=5
DOWNLOAD_LEASE_SECONDS=120
MAX_ASSET_BYTES=104857600
MEDIA_HOST_ALLOWLIST=*.cdninstagram.com,*.fbcdn.net

STORAGE_DIR=./storage

# kid:base64key pairs, comma-separated. Generate with: openssl rand -base64 32
CURSOR_SIGNING_KEYS=k1:replace-with-generated-base64-key

TRUST_PROXY=0
REST_RATE_PER_MIN=60
REST_BURST=20
GRAPHQL_COST_PER_MIN=10000

RAW_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=180

SLACK_WEBHOOK_URL=

SHUTDOWN_GRACE_MS=25000

# /internal/status and DELETE /internal/media/:id (spec §11, §12.3) are
# gated by an admin-scoped API key, not an env variable. Issue one with:
#   npm run apikey:create -- --name my-admin-key --scopes admin
